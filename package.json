{
  "name": "nordpool-scheduler-card",
  "private": true,
  "description": "A custom Home Assistant Lovelace card for Nordpool price-based scheduling",
  "main": "dist/nordpool-scheduler-card.js",
  "scripts": {
    "start": "rollup -c --watch",
    "build": "rollup -c",
    "lint": "eslint src --ext .ts && tsc --noEmit",
    "format": "prettier --write src/**/*.ts"
  },
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "nordpool",
    "scheduler"
  ],
  "author": "@klejejs",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.9",
    "rollup": "4.64.3",
    "rollup-plugin-serve": "3.0.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "home-assistant-js-websocket": "9.7.1",
    "lit": "3.3.3"
  }
}
