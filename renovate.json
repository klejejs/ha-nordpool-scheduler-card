{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "2 days",
  "rangeStrategy": "pin",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-prettier",
        "/^@typescript-eslint\\//"
      ]
    },
    {
      "groupName": "rollup",
      "matchPackageNames": ["rollup", "rollup-plugin-serve", "/^@rollup\\//"]
    },
    {
      "groupName": "babel",
      "matchPackageNames": ["/^@babel\\//"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "tslib"]
    }
  ]
}
